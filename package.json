{
  "name": "miminiapp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "24.22.2",
    "npm": "11.19.1"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321 --ignore-lock",
    "preview": "astro preview --host 127.0.0.1 --port 4321 --ignore-lock",
    "check": "astro check",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check \"src/**/*.{astro,ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"*.{json,mjs,ts}\"",
    "test:unit": "vitest run --project unit",
    "test:components": "vitest run --project components",
    "build": "astro build",
    "test:e2e": "npm run build && playwright test",
    "test:a11y": "npm run build && playwright test tests/e2e/a11y.spec.ts",
    "verify": "npm run check && npm run lint && npm run format:check && npm run test:unit && npm run test:components && npm run test:e2e && npm run test:integration",
    "capture:review": "npm run build && node tests/visual/capture.ts",
    "test:integration": "node tests/integration/modular-build.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "astro": "7.4.5",
    "@astrojs/react": "7.1.2",
    "typescript": "6.0.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "24.19.2",
    "tailwindcss": "4.3.4",
    "@tailwindcss/vite": "4.3.4",
    "vite": "8.3.5",
    "@vitejs/plugin-react": "6.2.1",
    "@astrojs/check": "0.9.12",
    "vitest": "5.1.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/user-event": "14.6.8",
    "@testing-library/jest-dom": "7.0.1",
    "jsdom": "30.1.3",
    "@playwright/test": "1.64.1",
    "@axe-core/playwright": "4.14.0",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2"
  }
}
