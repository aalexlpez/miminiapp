  viewBox="-15 -12 540 490"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <pattern
      id="laboratory-dots"
      width="18"
      height="18"
      patternUnits="userSpaceOnUse"
    >
      <circle cx="2" cy="2" r="1.6" fill="#7950F2" opacity=".5" />
    </pattern>
  </defs>
  <rect x="44" y="42" width="190" height="154" fill="url(#laboratory-dots)" />
  <circle cx="346" cy="141" r="104" fill="#B9F65A" />
  <rect
    x="96"
    y="228"
    width="142"
    height="140"
    rx="24"
    fill="#FF9368"
    transform="rotate(-15 167 298)"
  />
  <ellipse
    cx="268"
    cy="235"
    rx="223"
    ry="73"
    fill="none"
    stroke="#242136"
    stroke-width="2.3"
    transform="rotate(-24 268 235)"
  />
  <rect
    x="164"
    y="141"
    width="171"
    height="174"
    rx="30"
