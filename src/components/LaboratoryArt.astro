    r="38"
    fill="none"
    stroke="#242136"
    stroke-width="2"
  />
  <circle cx="127" cy="326" r="13" fill="#7950F2" />
  <path
    d="M183 392q18-33 36-1t36 0t36 0t36-1"
    stroke="#FF9368"
    stroke-width="9"
    fill="none"
    stroke-linecap="round"
  />
</svg>
