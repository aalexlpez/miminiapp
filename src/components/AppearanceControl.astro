---
import { getCommon } from '../i18n/common';
import type { Locale } from '../lib/locales';
interface Props {
  locale: Locale;
}
const copy = getCommon(Astro.props.locale).appearance;
const modes = ['light', 'dark', 'system'] as const;
---

<div class="appearance-control" role="group" aria-label={copy.label}>
  {modes.map((mode) => (
    <button
      type="button"
      class="appearance-option"
      data-appearance-option={mode}
      aria-label={copy[mode]}
      aria-pressed="false"
      title={copy[mode]}
      disabled
    >
      <svg
        viewBox="0 0 24 24"
        width="22"
        height="22"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        {mode === 'light' && (
          <>
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
          </>
        )}
        {mode === 'dark' && (
          <path d="M20.5 14a8.5 8.5 0 0 1-10.5-10.5A8.5 8.5 0 1 0 20.5 14Z" />
        )}
        {mode === 'system' && (
          <>
            <rect x="3" y="4" width="18" height="13" rx="2" />
            <path d="M8 21h8m-4-4v4" />
          </>
        )}
      </svg>
      <span class="appearance-indicator" aria-hidden="true"></span>
    </button>
  ))}
</div>
