---
import { getCommon } from '../i18n/common';
import type { Locale } from '../lib/locales';
interface Props {
  locale: Locale;
}
const copy = getCommon(Astro.props.locale).motion;
---

<div class="motion-control-slot">
  <button
    type="button"
    class="motion-toggle"
    data-motion-control
    hidden
    data-pause={copy.pause}
    data-resume={copy.resume}
    data-reduced={copy.reduced}
    data-running={copy.running}
    data-paused={copy.paused}
    aria-label={copy.pause}
    title={copy.pause}
    aria-describedby="motion-state"
  >
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <path d="m12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5Z" />
      <path d="M20 2v4m-2-2h4" />
      <path class="motion-icon-slash" d="M3 3 21 21" />
    </svg>
  </button>
  <span id="motion-state" class="sr-only" role="status"></span>
</div>
