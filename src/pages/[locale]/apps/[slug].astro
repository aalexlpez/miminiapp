---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { isLocale } from '../../../lib/locales';
import { getMiniappPaths, findPublished } from '../../../lib/miniapp-registry';
import { miniappRegistry } from '../../../miniapps/registry';

export function getStaticPaths() {
  return getMiniappPaths(miniappRegistry);
}

interface Props {
  id: string;
}

const { locale } = Astro.params;
if (!isLocale(locale)) throw new Error('Unsupported miniapp locale.');
const registration = findPublished(miniappRegistry, Astro.props.id);
const { descriptor } = registration;
const copy = descriptor.copy[locale];
const { default: Entry } = await registration.loadEntry();
---

<SiteLayout
  locale={locale}
  title={`${copy.title} · MiMiniApp`}
  description={copy.description}
  appSlug={descriptor.slug}
>
  <section
    class="miniapp-page"
    data-presentation={
      descriptor.presentation === 'focused' ? 'focused' : undefined
    }
    aria-labelledby="miniapp-title"
  >
    <header class="miniapp-heading">
      <h1 id="miniapp-title">{copy.title}</h1>
      <p>{copy.description}</p>
    </header>
    <Entry locale={locale} />
  </section>
</SiteLayout>

<style>
  .miniapp-page {
    padding-block: 3rem 4rem;
  }
  .miniapp-heading {
    max-width: 48rem;
    margin-bottom: 2rem;
  }
  h1 {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.1;
  }
  p {
    margin-top: 1rem;
    color: var(--color-muted);
    font-size: 1.125rem;
  }
  .miniapp-page[data-presentation='focused'] {
    padding-top: 1.5rem;
  }
  [data-presentation='focused'] .miniapp-heading {
    display: flex;
    align-items: baseline;
    gap: 1.375rem;
    max-width: none;
    margin-bottom: 2rem;
  }
  [data-presentation='focused'] h1 {
    font-size: 1.75rem;
    line-height: 1.2;
    letter-spacing: -0.03em;
  }
  [data-presentation='focused'] p {
    margin: 0;
    font-size: 1rem;
  }
  @media (max-width: 760px) {
    [data-presentation='focused'] .miniapp-heading {
      display: block;
      margin-bottom: 1.5rem;
    }
    [data-presentation='focused'] h1 {
      font-size: 1.375rem;
    }
    [data-presentation='focused'] p {
      margin-top: 0.25rem;
      font-size: 0.875rem;
    }
  }
</style>
