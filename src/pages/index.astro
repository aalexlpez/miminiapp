---
import EnvironmentFixture from '../components/EnvironmentFixture';
import '../styles/global.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="data:," />
    <title>Comprobación de entorno · MiMiniApp</title>
  </head>
  <body>
    <main class="mx-auto w-full max-w-5xl px-5 py-12 sm:px-8 sm:py-20">
      <header class="mb-9 max-w-2xl">
        <p class="text-sm font-semibold tracking-wide text-teal-800">
          MiMiniApp
        </p>
        <h1 class="mt-3 text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl">
          Comprobación de entorno
        </h1>
        <p class="mt-4 text-lg leading-8 text-slate-700">
          Base local de desarrollo y pruebas. El producto está en preparación.
        </p>
      </header>
      <EnvironmentFixture client:load />
      <footer class="mt-7 text-sm leading-6 text-slate-600">
        Página provisional para validar la integración de Astro, React y
        Tailwind CSS.
      </footer>
    </main>
  </body>
</html>
